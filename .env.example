# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq Cloud API (Optional - super fast free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter API (Optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Default Sentiment Analyzer ('gemini', 'groq', 'openrouter', or 'local')
DEFAULT_ANALYZER=gemini

# Port for local server (optional)
PORT=3000
